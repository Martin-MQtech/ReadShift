# ============================================
# ReBook 模型供应商配置
# 复制此文件为 .env 并填入你的密钥
# ============================================

# --- 供应商选择 ---
# openai | deepseek | qwen | glm | anthropic
LLM_PROVIDER=deepseek

# --- API 密钥 ---
LLM_API_KEY=sk-your-key-here

# --- 蓝领层 (经济模型, 干脏活) ---
# 批量 OCR 修复、错别字校正、结构化整理
ECON_MODEL=deepseek-chat

# --- 主编层 (旗舰模型, 产生核心溢价) ---
# 双语重塑、文风滤镜、商业词汇提炼
FLAGSHIP_MODEL=deepseek-reasoner

# --- 示例: 切到 OpenAI 生态 ---
# LLM_PROVIDER=openai
# LLM_API_KEY=sk-...
# ECON_MODEL=gpt-4o-mini
# FLAGSHIP_MODEL=gpt-4o

# --- 示例: 切到 Claude 生态 ---
# LLM_PROVIDER=anthropic
# LLM_API_KEY=sk-ant-...
# ECON_MODEL=claude-3-5-haiku
# FLAGSHIP_MODEL=claude-3-5-sonnet

# --- Zenmux 网关 (zcode 生态, 免费/低成本模型) ---
# 无需手动配置! 脚本会自动从 ~/.zcode/v2/config.json 发现凭据
# 可选: 通过环境变量覆盖
# LLM_PROVIDER=zenmux
# LLM_MODEL=deepseek/deepseek-v4-flash
