    <!-- ═══════════════ 小节导航浮层（两级目录 · 原生 JS） ═══════════════ -->
    <div class="secnav" id="secnav" style="display:none;" aria-hidden="true">
        <div class="secnav__overlay" id="secnav-overlay"></div>
        <div class="secnav__card">
            <div class="secnav__head">
                <span class="secnav__brand-title">张忠谋自传 · 双语典藏版</span>
                <button class="secnav__close" id="secnav-close" aria-label="关闭">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"/></svg>
                </button>
            </div>
            <ul class="secnav__list" id="secnav-list"></ul>
        </div>
    </div>

    <!-- ═══════════════ 页脚 ═══════════════ -->
    <footer>
        <div class="colophon__inner">
            <div class="colophon__ornament">❖</div>
            <p class="colophon__tagline">万物皆可重塑，期待有趣的灵魂在此相遇。</p>
            <p class="colophon__meta">Generated by ReadShift Engine · Text is the Genesis</p>
        </div>
    </footer>

    <script>
        // ─── 原书小节导航：两级目录（章 → 小节）原生 JS ───
        (function () {
            var subsections = <%- toc_json %> || [];
            var chapterList = <%- chapter_list_json %> || [];
            var multiChapter = <%- multi_chapter ? 'true' : 'false' %>;
            var nav = document.getElementById('secnav');
            var list = document.getElementById('secnav-list');
            var currentChapterStart = multiChapter ? (chapterList.length ? chapterList[0].start : 23) : 0;

            function renderList(chapterStart) {
                list.innerHTML = '';
                var items = subsections.filter(function (s) { return s.chapterStart === chapterStart; });
                if (!items.length) return;
                items.forEach(function (s) {
                    var li = document.createElement('li');
                    li.className = 'secnav__item';
                    var a = document.createElement('a');
                    a.className = 'secnav__link';
                    a.href = '#' + s.id;
                    var zh = document.createElement('span');
                    zh.className = 'secnav__zh';
                    zh.textContent = s.zh;
                    a.appendChild(zh);
                    if (s.en) {
                        var en = document.createElement('span');
                        en.className = 'secnav__en';
                        en.textContent = s.en;
                        a.appendChild(en);
                    }
                    li.appendChild(a);
                    list.appendChild(li);
                });
            }
                                    function openNav() {
                if (!nav || !list) return;
                list.innerHTML = '';

                // ── 多章合成：先渲染章列表（点击跳到各章正文章首） ──
                if (multiChapter && chapterList.length) {
                    var chapGroup = document.createElement('div');
                    chapGroup.className = 'secnav__chapter-group';
                    chapterList.forEach(function (ch, ci) {
                        var item = document.createElement('a');
                        item.className = 'secnav__chapter-link';
                        item.href = '#' + ch.anchor;
                        item.innerHTML = '<span class="secnav__num">' + (ci + 1 < 10 ? '0' : '') + (ci + 1) + '</span>' +
                                          '<div class="secnav__content">' +
                                            '<span class="secnav__zh">' + ch.zh + '</span>' +
                                            (ch.en ? '<span class="secnav__en">' + ch.en + '</span>' : '') +
                                          '</div>';
                        chapGroup.appendChild(item);
                    });
                    list.appendChild(chapGroup);
                }

                // 1. 检查页面是否存在序言卡片（仅在上册第一章或包含该锚点时渲染）
                <% if ((chapter_num === '1' && !title.includes('下册')) || (typeof has_vol1_preface !== 'undefined' && has_vol1_preface)) { %>
                var hasPref = document.getElementById('sec-yu-preface');
                if (hasPref) {
                    var prefGroup = document.createElement('div');
                    prefGroup.className = 'secnav__pref-group';
                    prefGroup.innerHTML = '<span class="secnav__chapter-num">PREFACE · 卷首序文</span>' +
                        '<a href="' + '#sec-yu-preface' + '" class="secnav__link">' +
                            '<span class="secnav__num">P1</span>' +
                            '<div class="secnav__content">' +
                                '<span class="secnav__zh">序一：为历史留下记录 (余秋雨)</span>' +
                                '<span class="secnav__en">Foreword I: Leaving a Record for History</span>' +
                            '</div>' +
                        '</a>' +
                        '<a href="' + '#sec-gao-preface' + '" class="secnav__link">' +
                            '<span class="secnav__num">P2</span>' +
                            '<div class="secnav__content">' +
                                '<span class="secnav__zh">序二：出版企业家传记的用心 (高希均)</span>' +
                                '<span class="secnav__en">Foreword II: The Intent of Publishing Entrepreneurs’ Memoirs</span>' +
                            '</div>' +
                        '</a>' +
                        '<a href="' + '#sec-self-preface' + '" class="secnav__link">' +
                            '<span class="secnav__num">P3</span>' +
                            '<div class="secnav__content">' +
                                '<span class="secnav__zh">自序：那是一个多么不同的时代！(张忠谋)</span>' +
                                '<span class="secnav__en">Author’s Preface: What a Truly Different Era That Was!</span>' +
                            '</div>' +
                        '</a>';
                    list.appendChild(prefGroup);
                }
                <% } %>

                // 2. 动态读取当前章大标题（多章时跟随 currentChapterStart 动态取章名）
                var chapHead = document.createElement('div');
                chapHead.className = 'secnav__chapter-header';
                var curZh = '<%- chapter_label_zh %>';
                var curEn = '<%- chapter_label_en %>';
                if (multiChapter && chapterList.length) {
                    for (var k = 0; k < chapterList.length; k++) {
                        if (chapterList[k].start === currentChapterStart) {
                            curZh = chapterList[k].zh;
                            curEn = chapterList[k].en;
                            break;
                        }
                    }
                }
                chapHead.innerHTML = '<span class="secnav__chapter-num">CHAPTER CONTENT · 本章结构</span>' +
                                     '<span class="secnav__chapter-title">' + curZh + '</span>' +
                                     (curEn ? '<span class="secnav__chapter-en">' + curEn + '</span>' : '');
                list.appendChild(chapHead);

                // 3. 当前章的小节（多章时按 currentChapterStart 过滤；单章时全部）
                var items = subsections;
                if (multiChapter) {
                    var start = currentChapterStart;
                    items = subsections.filter(function (s) { return s.chapterStart === start; });
                }
                items.forEach(function (s, idx) {
                    var numStr = (idx + 1 < 10 ? '0' : '') + (idx + 1);
                    var li = document.createElement('li');
                    li.className = 'secnav__item';
                    var a = document.createElement('a');
                    a.className = 'secnav__link';
                    a.href = '#' + s.id;
                    a.innerHTML = '<span class="secnav__num">' + numStr + '</span>' +
                                  '<div class="secnav__content">' +
                                    '<span class="secnav__zh">' + s.zh + '</span>' +
                                    (s.en ? '<span class="secnav__en">' + s.en + '</span>' : '') +
                                  '</div>';
                    li.appendChild(a);
                    list.appendChild(li);
                });
                nav.style.display = 'block';
                nav.setAttribute('aria-hidden', 'false');
            }
            function closeNav() {
                if (!nav) return;
                nav.style.display = 'none';
                nav.setAttribute('aria-hidden', 'true');
                
            }

            // 点击章节导航条 → 打开当前章小节目录
            document.addEventListener('click', function (e) {
                if (e.target.closest('#rh-toc-btn')) {
                    e.preventDefault();
                    if (nav.style.display === 'block') { closeNav(); } else { openNav(); }
                    return;
                }
                var chNav = e.target.closest('.chapter-nav--start');
                if (chNav) {
                    e.preventDefault();
                    var m = chNav.id.match(/^chap-(\d+)$/);
                    if (m) currentChapterStart = parseInt(m[1]);
                    openNav();
                    return;
                }
                // 目录里的章链接：更新当前章后关闭面板，让默认锚点跳转到章首
                var chLink = e.target.closest('.secnav__chapter-link');
                if (chLink) {
                    var mm = (chLink.getAttribute('href') || '').match(/chap-(\d+)/);
                    if (mm) currentChapterStart = parseInt(mm[1]);
                    closeNav();
                    return;
                }
                if (e.target.closest('#secnav-close') || e.target.closest('#secnav-overlay') || e.target.closest('.secnav__link')) {
                    closeNav();
                }
            });
            document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape') closeNav();
            });

            // 多章合成：滚动时更新当前章（用于目录当前章小节 + 章列表高亮）
            if (multiChapter && 'IntersectionObserver' in window) {
                var chapterObserver = new IntersectionObserver(function (entries) {
                    entries.forEach(function (en) {
                        if (en.isIntersecting) {
                            var m = (en.target.id || '').match(/^chap-(\d+)$/);
                            if (m) {
                                currentChapterStart = parseInt(m[1]);
                                // 高亮当前章列表项
                                var links = list.querySelectorAll('.secnav__chapter-link');
                                links.forEach(function (lk, i) {
                                    var targetCh = chapterList[i];
                                    if (targetCh && targetCh.start === currentChapterStart) {
                                        lk.classList.add('is-current');
                                    } else {
                                        lk.classList.remove('is-current');
                                    }
                                });
                            }
                        }
                    });
                }, { rootMargin: '-20% 0px -70% 0px', threshold: 0 });
                chapterList.forEach(function (ch) {
                    var el = document.getElementById(ch.anchor);
                    if (el) chapterObserver.observe(el);
                });
            }
        })();

        // ─── 知识窗：零框架原生 JS（双击即开，任何浏览器可用） ───
        (function () {
            var panel = document.getElementById('term-panel');
            var termEl = document.getElementById('term-panel-term');
            var meaningEl = document.getElementById('term-panel-meaning');
            var sentLabel = document.getElementById('term-panel-sentence-label');
            var sentEl = document.getElementById('term-panel-sentence');

            function openPanel(term, meaning, sentence) {
                if (!panel) return;
                termEl.textContent = term || '';
                meaningEl.textContent = meaning || '';
                if (sentence) {
                    sentLabel.style.display = '';
                    sentEl.style.display = '';
                    sentEl.textContent = sentence;
                } else {
                    sentLabel.style.display = 'none';
                    sentEl.style.display = 'none';
                }
                panel.style.display = '';
                panel.setAttribute('aria-hidden', 'false');
                document.body.classList.add('panel-open');
            }
            function closePanel() {
                if (!panel) return;
                panel.style.display = 'none';
                panel.setAttribute('aria-hidden', 'true');
                document.body.classList.remove('panel-open');
            }

            // 关闭按钮 / 遮罩 / Esc
            document.addEventListener('click', function (e) {
                if (e.target.closest('#rh-toc-btn')) {
                    e.preventDefault();
                    if (nav.style.display === 'block') { closeNav(); } else { openNav(); }
                    return;
                }
                if (e.target.closest('.term-panel__close') || e.target.closest('.term-panel__overlay')) {
                    closePanel();
                    return;
                }
                var term = e.target.closest('.interactive-term');
                if (term) {
                    openPanel(term.dataset.term, term.dataset.meaning, term.dataset.sentence);
                    return;
                }
                var item = e.target.closest('.cheat-item');
                if (item) {
                    openPanel(item.dataset.term, item.dataset.meaning, item.dataset.sentence);
                }
            });
            document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape') closePanel();
            });
        })();
    </script>
</body>
</html>
