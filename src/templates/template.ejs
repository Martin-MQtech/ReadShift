<!DOCTYPE html>
<html lang="zh-CN" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <!-- 引入 Tailwind CSS 让排版瞬间现代化 -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    typography: {
                        DEFAULT: {
                            css: {
                                maxWidth: '100%',
                                h1: { color: '#0f172a', fontWeight: '800' },
                                a: { color: '#2563eb', '&:hover': { color: '#1d4ed8' } },
                                blockquote: { borderLeftColor: '#3b82f6', backgroundColor: '#f8fafc', padding: '1rem', fontStyle: 'normal' },
                                table: { width: '100%', tableLayout: 'fixed' },
                                th: { textAlign: 'left', backgroundColor: '#f1f5f9', padding: '0.75rem' },
                                td: { padding: '0.75rem', verticalAlign: 'top', borderBottomWidth: '1px' }
                            },
                        },
                    },
                },
            },
            plugins: [
                // 自动加载 official typography 插件以极佳渲染 markdown 输出
                function({ addVariant }) {
                    addVariant('prose', '& > *');
                }
            ],
        }
    </script>
    <style type="text/tailwindcss">
        @layer utilities {
            /* 专门为我们的双语表格定制造型：左中右对比，右侧英文高亮 */
            .bilingual-table table { @apply w-full border-collapse shadow-sm rounded-lg hidden md:table; }
            .bilingual-table th { @apply bg-slate-800 text-white font-semibold; }
            .bilingual-table td:nth-child(1) { @apply w-1/2 pr-4 border-r border-slate-200 text-slate-700 leading-loose; }
            .bilingual-table td:nth-child(2) { @apply w-1/2 pl-4 text-slate-900 font-medium leading-loose text-lg font-serif; }
            
            /* 为商业词卡 (Cheat Sheet) 设定悬浮交互面板感 */
            .cheat-sheet-card { @apply my-8 p-6 bg-gradient-to-br from-blue-50 to-indigo-50 border border-blue-100 rounded-xl shadow-inner relative overflow-hidden; }
            .cheat-sheet-card::before { content: ""; @apply absolute top-0 left-0 w-1 h-full bg-blue-500; }
        }
    </style>
</head>
<body class="bg-[#fcfcfc] text-slate-800 antialiased font-sans selection:bg-blue-200">
    
    <nav class="sticky top-0 z-50 backdrop-blur-md bg-white/80 border-b border-slate-200">
        <div class="max-w-5xl mx-auto px-4 py-3 flex justify-between items-center">
            <div class="font-black text-xl tracking-tight bg-clip-text text-transparent bg-gradient-to-r from-blue-600 to-indigo-600">ReBook Engine</div>
            <div class="text-sm text-slate-500 font-medium font-mono"><%= current_mode %></div>
        </div>
    </nav>

    <main class="max-w-5xl mx-auto px-4 py-12 md:py-20">
        <article class="prose prose-slate prose-lg md:prose-xl lg:prose-2xl mx-auto bilingual-table">
            <%- body_content %>
        </article>
    </main>

    <footer class="mt-20 border-t border-slate-200 bg-slate-50 py-10">
        <div class="max-w-5xl mx-auto px-4 text-center text-slate-500 text-sm">
            <p>Generated by ReBook | Powered by AI & Human Intuition</p>
        </div>
    </footer>
</body>
</html>
