<!DOCTYPE html>
<html lang="zh-CN" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>

    <!-- 字体系统：完全本地化，使用系统内置字体（任何设备开箱即用，零外部请求） -->
    <style>
        /* 正文衬线：优先中文宋体/系统衬线，英文回退 Georgia */
        body { font-family: 'Songti SC', 'SimSun', 'Noto Serif CJK SC', Georgia, 'Times New Roman', serif; }
        /* 标题/UI 无衬线：系统级 */
        .running-head, .chapter-nav, .toc-card, .readers-guide, .rebook-card,
        .subsection-title, .term-panel, button {
            font-family: -apple-system, 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', 'Segoe UI', Roboto, sans-serif;
        }
        /* 英文斜体印刷感：罗马衬线（二创板块统一） */
        .subsection-title__en, .photo-caption__en, .cheat-item__term, .rhetoric-note .en, .knowledge-note .en {
            font-family: Georgia, 'Times New Roman', 'Songti SC', serif;
            font-style: italic;
            font-weight: 700;
            color: var(--ink);
        }
        /* 中文备注：楷体（二创板块统一） */
        .cheat-item__meaning, .rhetoric-note .zh, .knowledge-note .zh {
            font-family: 'STKaiti', 'KaiTi', '楷体', 'Songti SC', serif;
            font-style: italic;
        }
    </style>

    <style>
        /* ═══════════════════════════════════════════
           色彩体系 (Paper / Ink / Accent)
           ═══════════════════════════════════════════ */
        :root {
            --paper:    #faf8f3;
            --ink:      #1c1917;
            --ink-soft: #44403c;
            --ink-muted:#78716c;
            --rule:     #e7e0d3;
            --accent:   #9a3412;
            --accent-lt:#fed7aa;
            --deep:     #292524;
        }

        /* ═══════════════════════════════════════════
           全局重置 & 基础
           ═══════════════════════════════════════════ */
        *, *::before, *::after { box-sizing: border-box; }
        html { font-size: 17px; scroll-behavior: smooth; }
        body {
            margin: 0;
            background: var(--paper);
            color: var(--ink);
            font-family: 'Songti SC', 'SimSun', 'Noto Serif CJK SC', Georgia, 'Times New Roman', serif;
            line-height: 1.9;
            -webkit-font-smoothing: antialiased;
        }
        ::selection { background: var(--accent-lt); color: var(--ink); }

        /* ═══════════════════════════════════════════
           书眉 (Running Head)
           ═══════════════════════════════════════════ */
        .running-head {
            position: sticky;
            top: 0;
            z-index: 50;
            background: rgba(250,248,243,0.92);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border-bottom: 1px solid var(--rule);
            font-family: -apple-system, 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
        }
        .running-head__inner {
            max-width: 42rem;
            margin: 0 auto;
            padding: 0.6rem 1.5rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 1.5rem;
        }
        .running-head__brand {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            flex-shrink: 0;
        }
        .running-head__dot {
            width: 5px;
            height: 5px;
            border-radius: 50%;
            background: var(--accent);
            display: inline-block;
        }
        .running-head__brand-text {
            font-size: 0.6rem;
            font-weight: 400;
            letter-spacing: 0.06em;
            color: var(--ink-muted);
            opacity: 0.45;
        }
        .running-head__slogan {
            font-family: Georgia, 'Times New Roman', 'Songti SC', serif;
            font-size: 0.82rem;
            font-style: italic;
            color: var(--ink-soft);
            letter-spacing: 0.03em;
            flex: 1;
            text-align: center;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }
        .running-head__chapter {
            font-size: 0.62rem;
            font-weight: 400;
            letter-spacing: 0.08em;
            color: var(--ink-muted);
            opacity: 0.5;
            text-transform: uppercase;
            flex-shrink: 0;
            max-width: 40%;
            text-align: right;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        /* ═══════════════════════════════════════════
           扉页 (Title Page)
           ═══════════════════════════════════════════ */
        .title-page {
            max-width: 42rem;
            margin: 0 auto;
            padding: 5rem 2rem 4rem;
            text-align: center;
            animation: bookFade 0.9s ease both;
        }
        @keyframes bookFade {
            from { opacity: 0; transform: translateY(16px); }
            to   { opacity: 1; transform: translateY(0); }
        }
        .title-page__eyebrow {
            font-family: -apple-system, 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
            font-size: 0.7rem;
            letter-spacing: 0.22em;
            text-transform: uppercase;
            color: var(--ink-muted);
            margin-bottom: 1.5rem;
        }
        .title-page__title {
            font-family: Georgia, 'Times New Roman', 'Songti SC', serif;
            font-size: 2.6rem;
            font-weight: 800;
            color: var(--ink);
            letter-spacing: -0.01em;
            line-height: 1.2;
            margin: 0 0 1.5rem;
        }
        .title-page__author {
            font-family: -apple-system, 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
            font-size: 0.95rem;
            font-weight: 400;
            color: var(--ink-soft);
            letter-spacing: 0.04em;
            margin-bottom: 2.5rem;
        }
        /* 装饰分隔符 */
        .ornament {
            display: flex;
            align-items: center;
            gap: 1.2rem;
            margin: 0 auto 2.5rem;
            max-width: 20rem;
            color: var(--accent);
            font-size: 0.85rem;
        }
        .ornament::before,
        .ornament::after {
            content: "";
            flex: 1;
            height: 1px;
            background: linear-gradient(to right, transparent, var(--rule), transparent);
        }
        .title-page__quote {
            font-family: Georgia, 'Times New Roman', 'Songti SC', serif;
            font-size: 1.05rem;
            font-style: italic;
            color: var(--ink-muted);
            max-width: 28rem;
            margin: 0 auto;
            line-height: 1.8;
        }

        .title-page__author-en {
            font-family: -apple-system, 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
            font-size: 0.9rem;
            font-style: italic;
            color: var(--ink-muted);
            margin-bottom: 1.5rem;
        }

        /* 出版版权卡 */
        .title-page__copyright {
            max-width: 38rem;
            margin: 3rem auto 0;
            border: 1px solid var(--rule);
            border-radius: 10px;
            padding: 1.6rem 2rem;
            text-align: left;
            font-size: 0.85rem;
            color: var(--ink-soft);
            line-height: 2.1;
            background: #fdfcf8;
            box-shadow: 0 2px 12px rgba(28,25,23,0.04);
        }
        .title-page__copyright-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 0.25rem 0;
            border-bottom: 1px dashed var(--rule);
        }
        .title-page__copyright-row:last-child {
            border-bottom: none;
        }
        .title-page__copyright-label {
            font-family: -apple-system, 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
            font-size: 0.78rem;
            letter-spacing: 0.12em;
            color: var(--ink-muted);
            white-space: nowrap;
            margin-right: 1.5rem;
            flex-shrink: 0;
        }
        .title-page__copyright-value {
            text-align: right;
            font-weight: 600;
            font-size: 0.82rem;
            color: var(--ink);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        /* ═══════════════════════════════════════════
           正文区 (Main Content) — 单栏流动阅读
           ═══════════════════════════════════════════ */
        main {
            max-width: 42rem;
            margin: 0 auto;
            padding: 0 1.5rem 6rem;
        }

        /* 双语段落对 */
        .bilingual-pair {
            margin-bottom: 1.5rem;
        }
        .bilingual-pair + .bilingual-pair {
            margin-top: 0.25rem;
        }

        /* ReadShift 双语翻译框架：陶土橙左边线 + 微标签，与原书中文明确区分 */
        .rebook-translation {
            position: relative;
            margin: 1.25rem 0 1.5rem;
            padding: 0.9rem 1.25rem 0.6rem 1.25rem;
            border-left: 3px solid var(--accent);
            background: linear-gradient(to right, rgba(154,52,18,0.03), transparent 70%);
        }
        .rebook-translation__label {
            display: block;
            font-family: -apple-system, 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
            font-size: 0.62rem;
            font-weight: 700;
            letter-spacing: 0.22em;
            color: var(--accent);
            text-transform: uppercase;
            margin-bottom: 0.35rem;
        }
        .rebook-translation__label::before {
            content: "◆ ";
            font-size: 0.55rem;
        }
        .rebook-translation .en-para {
            margin-bottom: 0.6rem;
        }

        /* ═══ 章节导航条（解决读者迷路） ═══ */
        .chapter-nav {
            margin: 2.5rem 0 2rem;
        }
        .chapter-nav--start {
            text-align: center;
            padding: 2.5rem 2rem;
            background: linear-gradient(to bottom, #fdfcf8, #f5f0e6);
            border: 1px solid var(--rule);
            border-top: 3px solid var(--accent);
            border-radius: 12px;
        }
        .chapter-nav__badge {
            display: inline-block;
            font-family: -apple-system, 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
            font-size: 0.68rem;
            font-weight: 700;
            letter-spacing: 0.25em;
            color: var(--accent);
            text-transform: uppercase;
            background: rgba(154,52,18,0.08);
            padding: 0.2rem 0.9rem;
            border-radius: 4px;
            margin-bottom: 0.8rem;
        }
        .chapter-nav__title {
            font-family: Georgia, 'Times New Roman', 'Songti SC', serif;
            font-size: 1.7rem;
            font-weight: 800;
            color: var(--ink);
            margin: 0 0 0.4rem;
        }
        .chapter-nav__byline {
            font-family: -apple-system, 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
            font-size: 0.85rem;
            font-weight: 500;
            color: var(--ink-muted);
        }
        /* 🎯 章标题卡：首段英文副标题 + 装饰分割线（与小节标题双语风格统一） */
        .chapter-nav__title-en {
            display: block;
            font-family: 'Baskerville', 'Cormorant Garamond', Georgia, 'Times New Roman', 'Songti SC', serif;
            font-style: italic;
            font-weight: 400;
            font-size: 0.92rem;
            letter-spacing: 0.05em;
            color: var(--ink-muted);
            opacity: 0.82;
            margin: 0.15rem 0 0.7rem;
            line-height: 1.4;
        }
        .chapter-nav__divider {
            position: relative;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.8rem;
            margin: 0.9rem auto 1rem;
            max-width: 20rem;
        }
        .chapter-nav__divider::before,
        .chapter-nav__divider::after {
            content: "";
            height: 1px;
            flex: 1;
            background: linear-gradient(to right, transparent, var(--rule), var(--rule));
        }
        .chapter-nav__divider::after {
            background: linear-gradient(to left, transparent, var(--rule), var(--rule));
        }
        .chapter-nav__divider-orn {
            font-size: 0.72rem;
            color: var(--accent);
            opacity: 0.7;
        }
        .chapter-nav--mini {
            display: flex;
            align-items: center;
            gap: 0.6rem;
            margin: 1.8rem 0 0.5rem;
            padding: 0.5rem 0.9rem;
            background: rgba(245,240,230,0.7);
            border-left: 3px solid var(--accent);
            border-radius: 0 6px 6px 0;
            font-family: -apple-system, 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
            font-size: 0.72rem;
            font-weight: 600;
            letter-spacing: 0.08em;
            color: var(--ink-soft);
        }
        .chapter-nav__dot {
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: var(--accent);
            display: inline-block;
            flex-shrink: 0;
        }
        .chapter-nav__current {
            text-transform: uppercase;
            letter-spacing: 0.12em;
        }

        /* ═══════════════════════════════════════════
           序言卡 (Preface Card)
           ═══════════════════════════════════════════ */
        .preface-card {
            text-align: center;
            padding: 2.5rem 2rem;
            margin: 2rem 0;
            background: linear-gradient(to bottom, #fdfcf8, #f5f0e6);
            border: 1px solid var(--rule);
            border-top: 3px solid var(--accent);
            border-radius: 12px;
        }
        .preface-badge {
            display: inline-block;
            font-family: -apple-system, 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
            font-size: 0.68rem;
            font-weight: 700;
            letter-spacing: 0.2em;
            color: var(--accent);
            text-transform: uppercase;
            background: rgba(154,52,18,0.08);
            padding: 0.2rem 0.8rem;
            border-radius: 4px;
            margin-bottom: 0.8rem;
        }
        .preface-card h2 {
            font-family: Georgia, 'Times New Roman', 'Songti SC', serif;
            font-size: 1.5rem;
            font-weight: 700;
            color: var(--ink);
            margin: 0.5rem 0 0.6rem;
            line-height: 1.4;
        }
        .author-byline {
            font-family: -apple-system, 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
            font-size: 0.88rem;
            font-weight: 500;
            color: var(--ink-muted);
            margin: 0;
        }

        /* ═══════════════════════════════════════════
           阅读指南 (Reader's Guide)
           ═══════════════════════════════════════════ */
        .readers-guide {
            text-align: center;
            padding: 3rem 2rem;
            margin: 2rem 0;
            background: linear-gradient(to bottom, #fdfcf8, #f5f0e6);
            border: 1px solid var(--rule);
            border-top: 3px solid var(--accent);
            border-radius: 12px;
        }
        .readers-guide__header { margin-bottom: 1.5rem; }
        .readers-guide__eyebrow {
            display: block;
            font-family: -apple-system, 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
            font-size: 0.68rem;
            font-weight: 700;
            letter-spacing: 0.25em;
            color: var(--accent);
            text-transform: uppercase;
            margin-bottom: 0.5rem;
        }
        .readers-guide__title {
            font-family: Georgia, 'Times New Roman', 'Songti SC', serif;
            font-size: 1.8rem;
            font-weight: 700;
            color: var(--ink);
            margin: 0 0 0.5rem;
            letter-spacing: 0.05em;
        }
        .readers-guide__intro {
            font-family: Georgia, 'Times New Roman', 'Songti SC', serif;
            font-size: 0.95rem;
            line-height: 1.8;
            color: var(--ink-soft);
            max-width: 36rem;
            margin: 0 auto 2rem;
            text-indent: 0;
        }
        .readers-guide__items {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1.4rem 3.2rem;
            max-width: 44rem;
            margin: 0 auto;
            text-align: left;
        }
        /* 最后一个格（全景目录导航）横跨两列：居中平铺拉伸 */
        .readers-guide__item:last-child {
            grid-column: 1 / -1;
            align-items: center;
        }
        .readers-guide__item:last-child .readers-guide__mark {
            display: none;
        }
        .readers-guide__item:last-child .readers-guide__desc {
            text-align: center;
            padding: 0.6rem 1rem;
            background: rgba(154, 52, 18, 0.04);
            border: 1px dashed var(--rule);
            border-radius: 8px;
        }
        @media (max-width: 48rem) {
            .readers-guide__items { grid-template-columns: 1fr; gap: 1.5rem; }
            .readers-guide__item:last-child { grid-column: auto; }
            .readers-guide__item:last-child .readers-guide__mark { display: inline-block; }
            .readers-guide__item:last-child .readers-guide__desc { text-align: left; }
        }
                .readers-guide__item {
            display: flex;
            gap: 1.25rem;
            align-items: flex-start;
            padding-bottom: 2rem;
            margin-bottom: 2rem;
            border-bottom: 1px dotted var(--rule);
        }
        .readers-guide__item:nth-last-child(-n+2) { 
            border-bottom: none; 
            margin-bottom: 0;
            padding-bottom: 0;
        }
        @media (max-width: 48rem) {
            .readers-guide__item:nth-last-child(-n+2) {
                border-bottom: 1px dotted var(--rule);
                margin-bottom: 1.5rem;
                padding-bottom: 1.5rem;
            }
            .readers-guide__item:last-child {
                border-bottom: none;
                margin-bottom: 0;
                padding-bottom: 0;
            }
        }

        /* 四种标记的视觉语言：统一陶土橙基调，用边框样式区分 */
        .readers-guide__mark {
            flex-shrink: 0;
            width: 2rem;
            font-family: Georgia, 'Times New Roman', 'Songti SC', serif;
            font-size: 1rem;
            color: var(--accent);
            text-align: center;
            line-height: 1.4;
            padding-top: 0.2rem;
        }
        .readers-guide__mark--original { border-bottom: 2px solid var(--ink); padding-top: 0.5rem; }
        .readers-guide__mark--bilingual { border-left: 3px solid var(--accent); }
        .readers-guide__mark--cards    { border-bottom: 2px dashed var(--accent-lt); padding-top: 0.4rem; }
        .readers-guide__mark--terms    { border-left: 1px solid var(--accent); border-right: 1px solid var(--accent); padding: 0.2rem 0.3rem; }

        .readers-guide__label {
            font-family: -apple-system, 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
            font-size: 0.78rem;
            font-weight: 600;
            letter-spacing: 0.06em;
            color: var(--ink-muted);
            text-transform: uppercase;
            display: block;
            margin-bottom: 0.2rem;
        }
        .readers-guide__desc {
            font-family: Georgia, 'Times New Roman', 'Songti SC', serif;
            font-size: 0.9rem;
            line-height: 1.75;
            color: var(--ink-soft);
        }
        .mark-text { font-weight: 500; }
        .mark-text--orange { color: var(--accent); }
        .mark-text--warm   { background: #f5f0e6; padding: 0 4px; border-radius: 3px; }
        .mark-text--blue   { color: var(--accent); text-decoration: underline; text-decoration-color: rgba(154,52,18,0.4); text-underline-offset: 3px; }
        .readers-guide__project {
            margin-top: 2rem;
            font-family: Georgia, 'Times New Roman', 'Songti SC', serif;
            font-size: 0.75rem;
            color: var(--ink-muted);
            text-align: center;
            line-height: 1.6;
        }
        .readers-guide__project a {
            color: var(--ink-muted);
            text-decoration: none;
            border-bottom: 1px dotted var(--rule);
            margin-left: 0.2em;
        }
        .readers-guide__project a:hover {
            color: var(--accent);
            border-bottom-color: var(--accent);
        }
        /* GitHub 项目地址：银灰色、缩小、低调，不与正文抢视觉 */
        .readers-guide__project-link {
            margin-top: 0.9rem;
            font-family: Georgia, 'Times New Roman', serif;
            font-size: 0.72rem;
            color: #9298a0;
            text-align: center;
            line-height: 1.6;
        }
        .readers-guide__project-link a {
            color: #9298a0;
            text-decoration: none;
            border-bottom: 1px dotted rgba(146,152,160,0.55);
        }
        .readers-guide__project-link a:hover {
            color: var(--accent);
            border-bottom-color: var(--accent);
        }

        /* 中文段落：衬线体，首行缩进 2em */
        .cn-para {
            font-family: Georgia, 'Times New Roman', 'Songti SC', serif;
            font-size: 1.08rem;
            line-height: 1.95;
            color: var(--ink);
            text-indent: 2em;
            margin: 0 0 1.5rem;
            letter-spacing: 0.01em;
        }

        /* 英文段落：无衬线体，首行缩进 1.2em */
        .en-para {
            font-family: 'IBM Plex Sans', 'PingFang SC', sans-serif;
            font-size: 1.02rem;
            line-height: 1.85;
            color: var(--ink-soft);
            text-indent: 1.2em;
            margin: 0 0 1.5rem;
            letter-spacing: 0.01em;
        }
        /* 英文首段 Drop Cap */
        .en-para.en-first::first-letter {
            float: left;
            font-family: Georgia, 'Times New Roman', 'Songti SC', serif;
            font-size: 4.4em;
            line-height: 0.82;
            padding-right: 0.1em;
            padding-top: 0.06em;
            font-weight: 800;
            color: var(--accent);
            text-indent: 0 !important;
        }
        .en-para.en-first {
            text-indent: 0 !important;
        }

        /* 章节分隔线 */
        .section-divider {
            border: none;
            height: 1px;
            background: linear-gradient(to right, transparent, var(--rule), transparent);
            margin: 2.5rem 0;
        }

        /* 章节标题 */
        article h1, article h2, article h3 {
            font-family: Georgia, 'Times New Roman', 'Songti SC', serif;
            color: var(--ink);
            font-weight: 700;
            line-height: 1.3;
            margin-top: 2.5rem;
            margin-bottom: 1rem;
            text-indent: 0 !important;
        }
        article h1 { font-size: 1.8rem; letter-spacing: -0.01em; }
        article h2 { font-size: 1.35rem; }
        article h3 { font-size: 1.1rem; color: var(--ink-soft); }

        /* 列表无缩进 */
        article ul, article ol {
            padding-left: 1.5rem;
            margin: 1rem 0 1.5rem;
        }
        article li {
            font-family: Georgia, 'Times New Roman', 'Songti SC', serif;
            font-size: 1.02rem;
            line-height: 1.9;
            color: var(--ink-soft);
            margin-bottom: 0.5rem;
        }

        /* 引言块 */
        article blockquote {
            border-left: 3px solid var(--accent);
            background: #f5f0e6;
            margin: 1.5rem 0;
            padding: 1rem 1.5rem;
            border-radius: 0 6px 6px 0;
        }
        article blockquote p {
            text-indent: 0 !important;
            font-style: italic;
            color: var(--ink-soft);
            font-size: 1rem;
            line-height: 1.85;
            margin: 0;
        }

        /* ═══════════════════════════════════════════
           出版级可点击目录卡片 (Designed Interactive TOC)
           ═══════════════════════════════════════════ */
        .toc-card {
            background: #ffffff;
            border: 1px solid var(--rule);
            border-radius: 12px;
            padding: 2.2rem 2.5rem;
            margin: 3.5rem 0;
            box-shadow: 0 4px 20px rgba(28, 25, 23, 0.05);
        }
        .toc-card__header {
            text-align: center;
            margin-bottom: 2rem;
        }
        .toc-card__eyebrow {
            font-family: -apple-system, 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
            font-size: 0.72rem;
            font-weight: 700;
            letter-spacing: 0.25em;
            color: var(--accent);
            text-transform: uppercase;
        }
        .toc-card__title {
            font-family: Georgia, 'Times New Roman', 'Songti SC', serif;
            font-size: 2rem;
            font-weight: 800;
            color: var(--ink);
            margin: 0.4rem 0 0;
        }
        .toc-card__list {
            list-style: none;
            padding: 0;
            margin: 0;
        }
        .toc-card__item {
            margin-bottom: 0.9rem;
        }
        .toc-card__item:last-child {
            margin-bottom: 0;
        }
        .toc-card__link {
            display: flex;
            align-items: baseline;
            text-decoration: none;
            color: var(--ink);
            font-family: Georgia, 'Times New Roman', 'Songti SC', serif;
            font-size: 1.05rem;
            transition: color 0.15s ease;
        }
        .toc-card__link:hover {
            color: var(--accent);
        }
        .toc-card__name {
            font-weight: 600;
            white-space: nowrap;
        }
        .toc-card__dots {
            flex: 1;
            border-bottom: 1px dashed var(--rule);
            margin: 0 0.75rem;
            position: relative;
            top: -0.2em;
        }
        .toc-card__info {
            font-family: -apple-system, 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
            font-size: 0.85rem;
            color: var(--ink-muted);
            white-space: nowrap;
        }

        /* ═══════════════════════════════════════════
           自我审美重构：出版级杂志卡片 (Editorial Cheat Card)
           ═══════════════════════════════════════════ */
        .cheat-sheet {
            display: flex !important;
            flex-direction: column !important;
            gap: 1.25rem !important;
            margin: 2.2rem 0 !important;
        }

        .cheat-card {
            display: flex !important;
            flex-direction: column !important;
            gap: 0.9rem !important;
            padding: 1.4rem 1.6rem !important;
            background: #ffffff !important;
            border: 1px solid var(--rule) !important;
            border-radius: 10px !important;
            box-shadow: 0 2px 8px rgba(28, 25, 23, 0.04), 0 1px 3px rgba(28, 25, 23, 0.02) !important;
            cursor: pointer !important;
            transition: box-shadow 0.2s ease, transform 0.15s ease !important;
        }
        .cheat-card:hover {
            box-shadow: 0 6px 20px rgba(154, 52, 18, 0.12), 0 2px 6px rgba(28, 25, 23, 0.06) !important;
            transform: translateY(-2px) !important;
        }

        /* 卡片头部：词汇与对应中文名 */
        .cc-term {
            display: flex !important;
            align-items: baseline !important;
            justify-content: space-between !important;
            font-family: -apple-system, 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif !important;
            font-size: 1.12rem !important;
            font-weight: 700 !important;
            color: var(--accent) !important;
            border-bottom: 1px solid var(--rule) !important;
            padding-bottom: 0.65rem !important;
            padding-right: 0 !important;
            border-right: none !important;
        }

        /* 卡片主体：双列 45% : 55% 黄金平铺，彻底告别单字竖排挤压 */
        .cheat-card-body {
            display: grid !important;
            grid-template-columns: 1fr 1.25fr !important;
            gap: 1.5rem !important;
            align-items: start !important;
        }

        .cc-meaning {
            font-family: Georgia, 'Times New Roman', 'Songti SC', serif !important;
            font-size: 0.98rem !important;
            font-weight: 400 !important;
            color: var(--ink) !important;
            line-height: 1.75 !important;
            padding: 0 !important;
            text-indent: 0 !important;
        }

        /* 商业造句：浅雅对比内衬背景，取消 nowrap 截断，完全展示完整美感 */
        .cc-sentence {
            font-family: Georgia, 'Times New Roman', 'Songti SC', serif !important;
            font-size: 0.93rem !important;
            font-style: italic !important;
            color: var(--ink-soft) !important;
            line-height: 1.7 !important;
            padding: 0.8rem 1.1rem !important;
            background: #fdfbf7 !important;
            border-left: 3px solid var(--accent-lt) !important;
            border-radius: 0 6px 6px 0 !important;
            white-space: normal !important;            /* 彻底取消 ellipsis 强行截断 */
            overflow: visible !important;
            text-overflow: clip !important;
        }


        /* ═══════════════════════════════════════════
           小节标题 (原书子板块 · 居中加粗)
           ═══════════════════════════════════════════ */
        .subsection-title {
            text-align: center;
            margin: 2.6rem auto 1.4rem;
            padding: 0.5rem 0 0.4rem;
            font-family: -apple-system, 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
            font-weight: 700;
            letter-spacing: 0.14em;
            color: var(--ink);
            max-width: 30rem;
            border-bottom: 1px solid var(--rule);
            position: relative;
        }
        .subsection-title::before,
        .subsection-title::after {
            content: "";
            position: absolute;
            bottom: -1px;
            width: 2.2rem;
            height: 2px;
            background: var(--accent);
            opacity: 0.6;
        }
        .subsection-title::before { left: 50%; margin-left: -2.4rem; }
        .subsection-title::after  { right: 50%; margin-right: -2.4rem; }
        .subsection-title__zh {
            display: block;
            font-size: 1.02rem;
            letter-spacing: 0.22em;
        }
        .subsection-title__en {
            display: block;
            font-family: 'Baskerville', 'Cormorant Garamond', Georgia, 'Times New Roman', 'Songti SC', serif;
            font-style: italic;
            font-weight: 400;
            font-size: 0.78rem;
            letter-spacing: 0.05em;
            color: var(--ink-muted);
            margin-top: 0.25rem;
        }

                                        /* ═══════════════════════════════════════════
           低调挂卡：极致紧凑小字单行导航 (Ultra-Compact Low-Profile Nav)
           ═══════════════════════════════════════════ */
        .secnav {
            position: fixed;
            top: 2.3rem;
            left: 1.2rem;
            z-index: 100;
            display: none;
        }
        /* 目录遮罩：铺满全屏但不改变视觉，仅用于拦截"点击目录外空白 → 关闭" */
        .secnav__overlay {
            position: fixed;
            inset: 0;
            z-index: 99;      /* 在卡片(更高)之下、正文之上：点卡片是卡片交互，点之外是关闭 */
            background: transparent;
        }
        .secnav__card {
            position: relative;
            z-index: 101;     /* 浮在遮罩(99)之上：点卡片仍是卡片交互，点遮罩(外部)关闭 */
            width: min(92vw, 22rem);
            max-height: 68vh;
            overflow-y: auto;
            background: rgba(250, 248, 243, 0.97);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid var(--rule);
            border-radius: 6px;
            padding: 0.6rem 0.75rem 0.7rem;
            box-shadow: 0 8px 24px rgba(28, 25, 23, 0.14);
        }
        .secnav__link {
            display: flex;
            align-items: flex-start;
            gap: 0.45rem;
            padding: 0.35rem 0.35rem;
            text-decoration: none;
            color: var(--ink-soft);
            border-radius: 4px;
            transition: all 0.12s ease;
            white-space: normal !important;
            overflow: visible !important;
            word-break: break-word !important;
        }
        .secnav__link:hover {
            color: var(--accent);
            background: rgba(154, 52, 18, 0.06);
        }
        .secnav__num {
            font-family: 'Baskerville', 'Georgia', 'Times New Roman', serif;
            font-style: italic;
            font-size: 0.72rem;
            font-weight: 700;
            color: var(--accent);
            opacity: 0.85;
            flex-shrink: 0;
            margin-top: 0.05rem;
            min-width: 1.1rem;
        }
        .secnav__content {
            display: flex;
            flex-direction: column;
            gap: 0.1rem;
            flex: 1;
            white-space: normal !important;
            overflow: visible !important;
            word-break: break-word !important;
        }
        .secnav__zh {
            font-size: 0.72rem;
            font-weight: 500;
            color: var(--ink);
            line-height: 1.35;
            white-space: normal !important;
            word-break: break-word !important;
        }
        .secnav__en {
            font-family: Georgia, 'Times New Roman', serif;
            font-style: italic;
            font-size: 0.63rem;
            color: var(--ink-muted);
            opacity: 0.75;
            line-height: 1.3;
            white-space: normal !important;
            word-break: break-word !important;
            overflow: visible !important;
        }
        body.nav-open { overflow: hidden; }

        /* ═══════════════════════════════════════════
           照片图注 (Photo Container & Caption - 居中双语)
           ═══════════════════════════════════════════ */
        .photo-container {
            text-align: center;
            margin: 2.2rem auto 0.8rem;
            max-width: 100%;
        }
        .photo-img {
            display: block;
            margin: 0 auto;
            max-width: 85%;
            height: auto;
            border-radius: 6px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
            border: 1px solid var(--rule);
        }
        .photo-caption {
            font-family: -apple-system, 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
            font-size: 0.72rem;
            font-weight: 400;
            letter-spacing: 0.04em;
            color: var(--ink-muted);
            text-align: center;
            margin: 0.8rem auto 2rem;
            max-width: 32rem;
            line-height: 1.6;
        }
        .photo-caption__zh {
            display: block;
            color: var(--ink-soft);
            margin-bottom: 0.2rem;
        }
        .photo-caption__zh::before {
            content: "▧ ";
            color: var(--accent);
            opacity: 0.7;
        }
        .photo-caption__en {
            display: block;
            font-family: Georgia, 'Times New Roman', 'Songti SC', serif;
            font-size: 0.68rem;
            font-style: italic;
            color: var(--ink-muted);
            opacity: 0.85;
        }

        /* ═══════════════════════════════════════════
           二创延伸卡片 (ReBook Card - 高利用率旁注/备注式)
           ═══════════════════════════════════════════
           设计原则：低调不抢戏、高空间利用率、衬线/罗马斜体/楷体注脚感。 */
        .rebook-card {
            margin: 0.9rem 0;
            padding: 0.5rem 0.9rem 0.6rem;
            border: 1px solid var(--rule);
            border-left: 3px solid var(--accent);
            border-radius: 4px;
            background: rgba(250, 248, 243, 0.6);
        }
        .rebook-card__title {
            font-family: -apple-system, 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
            font-size: 0.62rem;
            font-weight: 700;
            letter-spacing: 0.12em;
            text-transform: uppercase;
            color: var(--accent);
            margin: 0 0 0.35rem;
            padding-bottom: 0.25rem;
            border-bottom: 1px dashed var(--rule);
        }
        .rebook-card__title-en {
            font-family: Georgia, 'Times New Roman', serif;
            font-style: italic;
            font-weight: 400;
            text-transform: none;
            letter-spacing: 0.04em;
            color: var(--ink-muted);
            opacity: 0.8;
            font-size: 0.58rem;
        }
        .rebook-card__body {
            font-size: 0.85rem;
        }
        /* ═══════════════════════════════════════════
           二创延伸卡片统一字体规范（三板块共享）
           ═══════════════════════════════════════════
           · 英文：黑色加粗斜体（Georgia 罗马系）
           · 中文：楷体小字
           · 全部小字备注风格，不喧宾夺主 */
        .rebook-card__body p,
        .rebook-card__body li {
            font-family: Georgia, 'Times New Roman', 'Songti SC', serif;
            font-size: 0.85rem !important;
            line-height: 1.65 !important;
            color: var(--ink-soft) !important;
            text-indent: 0 !important;
            margin-bottom: 0.4rem !important;
        }
        /* 修辞赏析：中英双语小字备注式（英文黑色加粗斜体 + 中文楷体斜体） */
        .rebook-card__body .rhetoric-note {
            display: block;
            font-size: 0.78rem;
            line-height: 1.6;
            color: var(--ink-soft);
            margin: 0.25rem 0;
            padding: 0;
            border: none;
        }
        .rebook-card__body .rhetoric-note .zh {
            color: var(--ink-soft);
            font-family: 'STKaiti', 'KaiTi', '楷体', 'Songti SC', serif;
            font-style: italic;
        }
        .rebook-card__body .rhetoric-note .en {
            color: var(--ink);
            font-family: Georgia, 'Times New Roman', 'Songti SC', serif;
            font-style: italic;
            font-weight: 700;
            opacity: 0.9;
            display: block;
            font-size: 0.75rem;
            margin-top: 0.1rem;
        }
        .rebook-card__body h1,
        .rebook-card__body h2,
        .rebook-card__body h3,
        .rebook-card__body h4 {
            font-family: -apple-system, 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif !important;
            font-size: 0.65rem !important;
            font-weight: 700 !important;
            letter-spacing: 0.1em !important;
            text-transform: uppercase !important;
            color: var(--accent) !important;
            margin: 0.5rem 0 0.3rem !important;
            padding-bottom: 0.2rem !important;
            border-bottom: 1px dashed var(--rule) !important;
        }
        .rebook-card__body strong { color: var(--ink); }
        .rebook-card__body ul,
        .rebook-card__body ol {
            margin: 0.2rem 0 0.3rem !important;
            padding-left: 1.1rem !important;
        }

        /* Cheat Sheet: 极致紧凑注脚式两栏/单行网格 —— 高利用率、英文黑色加粗斜体、中文楷体备注感、不抢戏 */
        .cheat-note-grid {
            display: flex;
            flex-direction: column;
            gap: 0.25rem;
            padding: 0.1rem 0;
        }
        .cheat-item {
            display: flex;
            flex-wrap: wrap;
            align-items: baseline;
            gap: 0.35rem 0.6rem;
            padding: 0.25rem 0;
            border-bottom: 1px dotted rgba(231, 224, 211, 0.7);
        }
        .cheat-item:last-child {
            border-bottom: none;
        }
        .cheat-item__term {
            font-family: Georgia, 'Times New Roman', 'Songti SC', serif !important;
            font-style: italic !important;
            font-weight: 700 !important;
            font-size: 0.84rem !important;
            color: var(--ink) !important;
            letter-spacing: 0.01em;
            background: none !important;
            padding: 0 !important;
            border: none !important;
        }
        .cheat-item__sep {
            color: var(--ink-muted);
            opacity: 0.45;
            font-size: 0.75rem;
        }
        .cheat-item__meaning {
            font-family: 'STKaiti', 'KaiTi', '楷体', 'Songti SC', serif !important;
            font-size: 0.82rem !important;
            font-weight: 400 !important;
            color: var(--ink-soft) !important;
            line-height: 1.5 !important;
            background: none !important;
            padding: 0 !important;
            border: none !important;
        }
            padding: 0 !important;
            border: none !important;
        }
        .rebook-card__body .cc-sentence {
            display: none !important;
        }

        /* ═══════════════════════════════════════════
           背景知识延伸 (Knowledge Note - 中英双语小字斜体备注)
           字体与修辞赏析/Cheat Sheet 统一：
           英文黑色加粗斜体 + 中文楷体斜体
           ═══════════════════════════════════════════ */
        .knowledge-note {
            margin: 0.35rem 0;
            padding: 0.15rem 0;
            line-height: 1.6;
        }
        .knowledge-note .zh {
            display: inline;
            font-family: 'STKaiti', 'KaiTi', '楷体', 'Songti SC', serif;
            font-style: italic;
            font-size: 0.78rem;
            color: var(--ink-soft);
        }
        .knowledge-note .en {
            display: inline;
            font-family: Georgia, 'Times New Roman', 'Songti SC', serif;
            font-style: italic;
            font-weight: 700;
            font-size: 0.72rem;
            color: var(--ink);
            opacity: 0.9;
        }
        .knowledge-note .zh::after {
            content: "  ";
            white-space: pre;
        }
        .knowledge-note .en::before {
            content: " — ";
            color: var(--ink-muted);
            opacity: 0.5;
        }

        /* 兼容旧样式（未折叠时） */
        .knowledge-window {
            margin: 1.2rem 0;
            padding: 1rem 1.25rem;
            background: #faf8f3;
            border-radius: 6px;
            border: 1px solid var(--rule);
            border-left: 2px solid var(--accent-lt);
        }
        .knowledge-window h3,
        .knowledge-window h4 {
            font-family: -apple-system, 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
            font-size: 0.72rem;
            font-weight: 600;
            letter-spacing: 0.15em;
            text-transform: uppercase;
            color: var(--ink-muted);
            margin-top: 0;
            margin-bottom: 0.8rem;
            padding-bottom: 0.4rem;
            border-bottom: 1px solid var(--rule);
        }
        .knowledge-window p,
        .knowledge-window li {
            font-family: Georgia, 'Times New Roman', 'Songti SC', serif;
            font-size: 0.88rem;
            line-height: 1.8;
            color: var(--ink-soft);
            text-indent: 0 !important;
            margin-bottom: 0.5rem;
        }

        /* ═══════════════════════════════════════════
           互动词汇 (Interactive Term)
           ═══════════════════════════════════════════ */
        .interactive-term {
            cursor: pointer;
            color: var(--accent);
            font-weight: 600;
            text-decoration: underline;
            text-decoration-color: var(--accent-lt);
            text-decoration-thickness: 2px;
            text-underline-offset: 4px;
            padding: 0 2px;
            border-radius: 3px;
            transition: background 0.15s ease, color 0.15s ease;
        }
        .interactive-term:hover {
            background: rgba(154,52,18,0.08);
            color: #7c2d12;
        }

        /* ═══════════════════════════════════════════
           页脚 (Colophon)
           ═══════════════════════════════════════════ */
        footer {
            border-top: 1px solid var(--rule);
            background: rgba(245,240,230,0.6);
            padding: 3rem 1.5rem;
            text-align: center;
        }
        .colophon__inner {
            max-width: 42rem;
            margin: 0 auto;
        }
        .colophon__ornament {
            color: var(--accent);
            font-size: 1rem;
            margin-bottom: 1rem;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 1rem;
        }
        .colophon__ornament::before,
        .colophon__ornament::after {
            content: "";
            width: 4rem;
            height: 1px;
            background: var(--rule);
        }
        .colophon__tagline {
            font-family: Georgia, 'Times New Roman', 'Songti SC', serif;
            font-size: 0.95rem;
            font-style: italic;
            color: var(--ink-muted);
            margin-bottom: 1.2rem;
        }
        .colophon__meta {
            font-family: -apple-system, 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
            font-size: 0.68rem;
            letter-spacing: 0.18em;
            text-transform: uppercase;
            color: var(--ink-muted);
        }

        /* ═══════════════════════════════════════════
           知识窗侧边栏 (Slide-over)
           ═══════════════════════════════════════════ */
        .term-panel {
            position: fixed;
            position: sticky; top: 2.2rem; left: 1rem; z-index: 99;
            z-index: 99;
            display: none;
        }
        .term-panel[ x-show ] { display: flex; }
        .term-panel__overlay {
            position: absolute;
            position: sticky; top: 2.2rem; left: 1rem; z-index: 99;
            background: rgba(41,37,36,0.35);
            backdrop-filter: blur(4px);
        }
        .term-panel__card {
            position: relative;
            width: 100%;
            max-width: 28rem;
            margin-left: auto;
            height: 100%;
            background: var(--paper);
            box-shadow: -8px 0 32px rgba(28,25,23,0.15);
            padding: 2.5rem 2rem;
            overflow-y: auto;
            border-left: 1px solid var(--rule);
        }
        .term-panel__close {
            position: absolute;
            top: 1.2rem;
            right: 1.2rem;
            background: none;
            border: none;
            cursor: pointer;
            color: var(--ink-muted);
            transition: color 0.15s;
        }
        .term-panel__close:hover { color: var(--ink); }
        .term-panel__label {
            font-family: -apple-system, 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
            font-size: 0.68rem;
            font-weight: 600;
            letter-spacing: 0.18em;
            text-transform: uppercase;
            color: var(--ink-muted);
